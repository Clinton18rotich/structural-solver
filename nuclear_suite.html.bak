<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>☢️ Nuclear Structural Suite V2</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}
        body{background:linear-gradient(135deg,#0a0e27,#1a1a3e);display:flex;flex-direction:column;min-height:100vh;color:#e0e0e0}
        header{background:#0d1b2a;padding:20px;text-align:center;border-bottom:4px solid #e74c3c}
        header h1{font-size:26px;color:#e74c3c;text-shadow:0 0 10px rgba(231,76,60,0.5)}
        header p{font-size:14px;color:#a0c4ff;margin-top:5px}
        .container{display:flex;flex:1;flex-wrap:wrap}
        .sidebar{width:100%;max-width:260px;background:rgba(13,27,42,0.95);padding:20px;display:flex;flex-direction:column;gap:8px;border-right:2px solid #e74c3c}
        .tab-btn{padding:14px;background:transparent;color:#a0c4ff;border:1px solid rgba(231,76,60,0.3);text-align:left;font-size:14px;cursor:pointer;border-radius:8px;transition:0.3s;font-weight:600}
        .tab-btn:hover,.tab-btn.active{background:linear-gradient(90deg,#e74c3c,#c0392b);color:#fff;border-color:#e74c3c;box-shadow:0 0 15px rgba(231,76,60,0.4)}
        .content{flex:1;padding:25px;min-width:300px}
        .tab-content{display:none;animation:fadeIn 0.5s}
        .tab-content.active{display:block}
        @keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
        .input-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:15px;margin-bottom:20px;background:rgba(13,27,42,0.7);padding:20px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.4);border:1px solid rgba(231,76,60,0.2)}
        .input-grid label{display:flex;flex-direction:column;font-weight:600;font-size:13px;color:#a0c4ff}
        .input-grid input,.input-grid select{margin-top:6px;padding:10px 14px;border:1px solid rgba(231,76,60,0.3);border-radius:8px;font-size:14px;background:#0a0e27;color:#e0e0e0;transition:0.3s}
        .input-grid input:focus,.input-grid select:focus{border-color:#e74c3c;outline:none;box-shadow:0 0 10px rgba(231,76,60,0.3)}
        .action-btn{background:linear-gradient(90deg,#e74c3c,#c0392b);color:white;border:none;padding:14px 30px;border-radius:8px;font-size:16px;font-weight:700;cursor:pointer;width:100%;max-width:300px;transition:0.3s;text-transform:uppercase;letter-spacing:1px}
        .action-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(231,76,60,0.5)}
        .report-box{margin-top:25px;background:rgba(13,27,42,0.8);padding:25px;border-radius:12px;border-left:6px solid #e74c3c;box-shadow:0 4px 20px rgba(0,0,0,0.4);overflow-x:auto}
        .report-box h3{color:#e74c3c;border-bottom:2px solid rgba(231,76,60,0.3);padding-bottom:12px;margin-bottom:15px;font-size:18px}
        .report-box hr{border:0;border-top:1px dashed rgba(231,76,60,0.2);margin:15px 0}
        .step-title{font-weight:700;color:#e74c3c;font-size:15px;display:block;margin-bottom:6px}
        .step-body{color:#c0d0e0;line-height:1.7;font-family:'Courier New',monospace;font-size:14px;padding-left:10px}
        .pass{color:#00e676;font-weight:bold;text-shadow:0 0 5px rgba(0,230,118,0.5)}
        .fail{color:#ff1744;font-weight:bold;text-shadow:0 0 5px rgba(255,23,68,0.5)}
        h2{color:#e74c3c;margin-bottom:20px;font-size:22px;border-bottom:2px solid rgba(231,76,60,0.2);padding-bottom:10px}
        @media(max-width:600px){.sidebar{max-width:100%}.input-grid{grid-template-columns:1fr}}
    </style>
</head>
<body>
    <header>
        <h1>☢️ NUCLEAR STRUCTURAL SUITE V2</h1>
        <p>BS 8110:1997 • BS 5950-1:2000 | Beams • Slabs • Columns • Footings • Walls • Steel</p>
    </header>
    <div class="container">
        <div class="sidebar">
            <button class="tab-btn active" onclick="switchTab('rcbeam', event)">🧱 RC Beam</button>
            <button class="tab-btn" onclick="switchTab('rcslab', event)">📐 RC Slab</button>
            <button class="tab-btn" onclick="switchTab('rccolumn', event)">🏢 RC Column</button>
            <button class="tab-btn" onclick="switchTab('rcfooting', event)">⬇️ Pad Footing</button>
            <button class="tab-btn" onclick="switchTab('rcwall', event)">🧱 Retaining Wall</button>
            <button class="tab-btn" onclick="switchTab('steelbeam', event)">⚙️ Steel Beam</button>
            <button class="tab-btn" onclick="switchTab('steelcol', event)">🗼 Steel Column</button>
        </div>
        <div class="content">
            <!-- RC BEAM -->
            <div id="rcbeam-tab" class="tab-content active">
                <h2>🧱 RC Beam Design (BS 8110-1:1997)</h2>
                <div class="input-grid">
                    <label>Span (m): <input type="number" id="c_span" value="6" step="0.1"></label>
                    <label>Dead Load (kN/m): <input type="number" id="c_gk" value="25" step="0.1"></label>
                    <label>Live Load (kN/m): <input type="number" id="c_qk" value="19" step="0.1"></label>
                    <label>Width b (mm): <input type="number" id="c_b" value="300"></label>
                    <label>Depth h (mm): <input type="number" id="c_h" value="600"></label>
                    <label>f_cu (N/mm²): <input type="number" id="c_fcu" value="30"></label>
                    <label>f_y (N/mm²): <input type="number" id="c_fy" value="460"></label>
                    <label>Cover (mm): <input type="number" id="c_cov" value="25"></label>
                </div>
                <button class="action-btn" onclick="solveRCBeam()">☢️ Design RC Beam</button>
                <div id="c_output" class="report-box"></div>
            </div>
            <!-- RC SLAB -->
            <div id="rcslab-tab" class="tab-content">
                <h2>📐 One-Way Slab Design</h2>
                <div class="input-grid">
                    <label>Span (m): <input type="number" id="s_span" value="4.25" step="0.1"></label>
                    <label>Dead Load (kN/m²): <input type="number" id="s_gk" value="4.5" step="0.1"></label>
                    <label>Live Load (kN/m²): <input type="number" id="s_qk" value="4" step="0.1"></label>
                    <label>f_cu (N/mm²): <input type="number" id="s_fcu" value="35"></label>
                    <label>f_y (N/mm²): <input type="number" id="s_fy" value="500"></label>
                    <label>Cover (mm): <input type="number" id="s_cov" value="25"></label>
                </div>
                <button class="action-btn" onclick="solveRCSlab()">☢️ Design Slab</button>
                <div id="s_output" class="report-box"></div>
            </div>
            <!-- RC COLUMN -->
            <div id="rccolumn-tab" class="tab-content">
                <h2>🏢 Short Braced Column</h2>
                <div class="input-grid">
                    <label>Axial Load N (kN): <input type="number" id="col_N" value="3000"></label>
                    <label>Moment Mx (kNm): <input type="number" id="col_Mx" value="100"></label>
                    <label>Moment My (kNm): <input type="number" id="col_My" value="20"></label>
                    <label>Width b (mm): <input type="number" id="col_b" value="350"></label>
                    <label>Depth h (mm): <input type="number" id="col_h" value="350"></label>
                    <label>f_cu (N/mm²): <input type="number" id="col_fcu" value="40"></label>
                    <label>f_y (N/mm²): <input type="number" id="col_fy" value="500"></label>
                    <label>Cover (mm): <input type="number" id="col_cov" value="35"></label>
                </div>
                <button class="action-btn" onclick="solveRCColumn()">☢️ Design Column</button>
                <div id="col_output" class="report-box"></div>
            </div>
            <!-- PAD FOOTING -->
            <div id="rcfooting-tab" class="tab-content">
                <h2>⬇️ Pad Footing Design</h2>
                <div class="input-grid">
                    <label>Column Load N (kN): <input type="number" id="f_N" value="3000"></label>
                    <label>Column Width (mm): <input type="number" id="f_cb" value="400"></label>
                    <label>Column Depth (mm): <input type="number" id="f_ch" value="400"></label>
                    <label>Bearing Capacity (kN/m²): <input type="number" id="f_bear" value="170"></label>
                    <label>f_cu (N/mm²): <input type="number" id="f_fcu" value="35"></label>
                    <label>f_y (N/mm²): <input type="number" id="f_fy" value="500"></label>
                    <label>Cover (mm): <input type="number" id="f_cov" value="50"></label>
                </div>
                <button class="action-btn" onclick="solveRCFooting()">☢️ Design Footing</button>
                <div id="f_output" class="report-box"></div>
            </div>
            <!-- RETAINING WALL -->
            <div id="rcwall-tab" class="tab-content">
                <h2>🧱 Cantilever Retaining Wall</h2>
                <div class="input-grid">
                    <label>Wall Height H (m): <input type="number" id="w_H" value="5.4" step="0.1"></label>
                    <label>Soil Density γ (kN/m³): <input type="number" id="w_g" value="19"></label>
                    <label>Friction Angle φ (°): <input type="number" id="w_phi" value="30"></label>
                    <label>Base Friction μ: <input type="number" id="w_mu" value="0.4" step="0.1"></label>
                    <label>Allowable Bearing (kN/m²): <input type="number" id="w_bear" value="120"></label>
                    <label>f_cu (N/mm²): <input type="number" id="w_fcu" value="35"></label>
                    <label>f_y (N/mm²): <input type="number" id="w_fy" value="500"></label>
                </div>
                <button class="action-btn" onclick="solveRCWall()">☢️ Design Wall</button>
                <div id="w_output" class="report-box"></div>
            </div>
            <!-- STEEL BEAM -->
            <div id="steelbeam-tab" class="tab-content">
                <h2>⚙️ Steel Beam (BS 5950-1:2000)</h2>
                <div class="input-grid">
                    <label>Span (m): <input type="number" id="sb_span" value="10" step="0.1"></label>
                    <label>Dead Load (kN/m): <input type="number" id="sb_gk" value="5" step="0.1"></label>
                    <label>Live Load (kN/m): <input type="number" id="sb_qk" value="15" step="0.1"></label>
                    <label>Steel Grade: <select id="sb_grade"><option value="275">S275</option><option value="355" selected>S355</option><option value="460">S460</option></select></label>
                    <label>Restraint: <select id="sb_rest"><option value="yes">Fully Restrained</option><option value="no">Unrestrained (LTB)</option></select></label>
                </div>
                <button class="action-btn" onclick="solveSteelBeam()">☢️ Design Steel Beam</button>
                <div id="sb_output" class="report-box"></div>
            </div>
            <!-- STEEL COLUMN -->
            <div id="steelcol-tab" class="tab-content">
                <h2>🗼 Steel Column (BS 5950)</h2>
                <div class="input-grid">
                    <label>Axial Load N (kN): <input type="number" id="sc_N" value="3000"></label>
                    <label>Column Height (m): <input type="number" id="sc_L" value="5"></label>
                    <label>Effective Length Factor k: <select id="sc_k"><option value="0.7">0.7 (Fixed-Pinned)</option><option value="1.0" selected>1.0 (Pinned-Pinned)</option><option value="1.2">1.2 (Partially Fixed)</option><option value="2.0">2.0 (Cantilever)</option></select></label>
                    <label>Steel Grade: <select id="sc_grade"><option value="275">S275</option><option value="355" selected>S355</option></select></label>
                </div>
                <button class="action-btn" onclick="solveSteelColumn()">☢️ Design Steel Column</button>
                <div id="sc_output" class="report-box"></div>
            </div>
        </div>
    </div>
    <script>
        // === CORE FUNCTIONS ===
        function switchTab(tabId, e) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId + '-tab').classList.add('active');
            if (e) e.target.classList.add('active');
        }
        function getVal(id) { return parseFloat(document.getElementById(id).value) || 0; }
        function getSel(id) { return document.getElementById(id).value; }
        function printReport(id, steps) {
            let html = "<h3>☢️ NUCLEAR DESIGN REPORT</h3>";
            steps.forEach(s => {
                html += `<hr><span class="step-title">${s.title}</span><div class="step-body">${s.body}</div>`;
            });
            document.getElementById(id).innerHTML = html;
        }

        // === BS 8110: RC BEAM ===
        function solveRCBeam() {
            let L = getVal('c_span'), gk = getVal('c_gk'), qk = getVal('c_qk');
            let b = getVal('c_b'), h = getVal('c_h'), fcu = getVal('c_fcu');
            let fy = getVal('c_fy'), cov = getVal('c_cov');
            let steps = [];
            let w = 1.4 * gk + 1.6 * qk;
            steps.push({ title: "1. Ultimate Load (Eq 3.2)", body: `w = 1.4Gk + 1.6Qk = 1.4(${gk}) + 1.6(${qk}) = <strong>${w.toFixed(2)} kN/m</strong>` });
            let M = w * L * L / 8;
            steps.push({ title: "2. Design Moment", body: `M = wL²/8 = ${w.toFixed(2)} × ${L}² / 8 = <strong>${M.toFixed(2)} kNm</strong>` });
            let d = h - cov - 8 - 10;
            steps.push({ title: "3. Effective Depth", body: `Assume 8mm links, 20mm bars<br>d = h - cover - link - bar/2<br>d = ${h} - ${cov} - 8 - 10 = <strong>${d} mm</strong>` });
            let K = M / (fcu * b * d * d * 1e-6);
            let Mu = 0.156 * fcu * b * d * d / 1e6;
            steps.push({ title: "4. K-Value Check (Cl 3.4.4.4)", body: `K = M / (fcu·b·d²) = <strong>${K.toFixed(4)}</strong><br>Mu (max singly) = ${Mu.toFixed(1)} kNm<br>${K <= 0.156 ? '<span class="pass">K ≤ 0.156 → Singly reinforced</span>' : '<span class="fail">K > 0.156 → Compression steel required</span>'}` });
            let As, z;
            if (K <= 0.156) {
                z = d * (0.5 + Math.sqrt(0.25 - K / 0.9));
                if (z > 0.95 * d) z = 0.95 * d;
                As = M * 1e6 / (0.87 * fy * z);
                steps.push({ title: "5. Singly Reinforced (Eq 8)", body: `z = d(0.5+√(0.25-K/0.9)) = <strong>${z.toFixed(1)} mm</strong><br>As = M / (0.87·fy·z) = <strong>${As.toFixed(0)} mm²</strong>` });
            } else {
                let d2 = cov + 8 + 10;
                let z2 = d * (0.5 + Math.sqrt(0.25 - 0.156 / 0.9));
                let As1 = Mu * 1e6 / (0.87 * fy * z2);
                let As2 = (M * 1e6 - Mu * 1e6) / (0.87 * fy * (d - d2));
                As = As1 + As2;
                steps.push({ title: "5. Doubly Reinforced (Eq 9)", body: `As,tension = <strong>${As.toFixed(0)} mm²</strong><br>As,compression = <strong>${As2.toFixed(0)} mm²</strong>` });
            }
            let V = w * L / 2, v = V * 1000 / (b * d);
            let rho = Math.min(Math.max(As / (b * d), 0.002), 0.04);
            let vc = 0.79 * Math.pow(100 * rho, 1 / 3) * Math.pow(400 / d, 0.25) * Math.pow(fcu / 25, 1 / 3) / 1.25;
            steps.push({ title: "6. Shear Check (Cl 3.4.5)", body: `V = wL/2 = <strong>${V.toFixed(1)} kN</strong><br>v = V/(b·d) = <strong>${v.toFixed(2)} N/mm²</strong><br>vc = <strong>${vc.toFixed(2)} N/mm²</strong><br>${v <= vc ? '<span class="pass">SHEAR OK - No links required</span>' : v <= vc + 0.4 ? 'Nominal links: T8@300 c/c' : '<span class="fail">Shear links: T10@200 c/c</span>'}` });
            steps.push({ title: "✅ BEAM SUMMARY", body: `Section: <strong>${b}×${h} mm</strong><br>Span: ${L}m<br>Reinforcement: <strong>${As.toFixed(0)} mm²</strong> (${Math.ceil(As / 314)}T20 bars)<br>Cover: ${cov}mm<br><span class="pass">NUCLEAR COMPLIANT ✓</span>` });
            printReport('c_output', steps);
        }

        // === BS 8110: RC SLAB ===
        function solveRCSlab() {
            let L = getVal('s_span'), gk = getVal('s_gk'), qk = getVal('s_qk');
            let fcu = getVal('s_fcu'), fy = getVal('s_fy'), cov = getVal('s_cov');
            let steps = [];
            let w = 1.4 * gk + 1.6 * qk;
            steps.push({ title: "1. Ultimate Load", body: `w = 1.4(${gk}) + 1.6(${qk}) = <strong>${w.toFixed(2)} kN/m²</strong>` });
            let M = w * L * L / 8;
            steps.push({ title: "2. Design Moment (per m width)", body: `M = wL²/8 = <strong>${M.toFixed(2)} kNm/m</strong>` });
            let h = Math.ceil(L * 1000 / 20 / 10) * 10;
            let d = h - cov - 5;
            steps.push({ title: "3. Depth Selection", body: `h ≈ span/20 = ${(L * 1000 / 20).toFixed(0)}mm → Use <strong>${h} mm</strong><br>d = ${h} - ${cov} - 5 = <strong>${d} mm</strong>` });
            let K = M / (fcu * 1000 * d * d * 1e-6);
            if (K > 0.156) { h += 20; d = h - cov - 5; K = M / (fcu * 1000 * d * d * 1e-6); steps.push({ title: "3b. Adjusted Depth", body: `K too high → h increased to <strong>${h}mm</strong>` }); }
            let z = d * (0.5 + Math.sqrt(0.25 - K / 0.9));
            if (z > 0.95 * d) z = 0.95 * d;
            let As = M * 1e6 / (0.87 * fy * z);
            let AsMin = 0.0013 * 1000 * h;
            As = Math.max(As, AsMin);
            let spacing = Math.floor(1000 / (As / 113));
            steps.push({ title: "4. Reinforcement", body: `K = ${K.toFixed(4)}<br>z = ${z.toFixed(1)} mm<br>As = <strong>${As.toFixed(0)} mm²/m</strong> (min: ${AsMin.toFixed(0)} mm²/m)` });
            steps.push({ title: "✅ SLAB SUMMARY", body: `Thickness: <strong>${h} mm</strong><br>Main bars: T12 @ <strong>${Math.min(spacing, 300)} mm c/c</strong><br>Distribution: T10 @ 300 c/c<br>Cover: ${cov}mm<br><span class="pass">NUCLEAR COMPLIANT ✓</span>` });
            printReport('s_output', steps);
        }

        // === BS 8110: RC COLUMN ===
        function solveRCColumn() {
            let N = getVal('col_N'), Mx = getVal('col_Mx'), My = getVal('col_My');
            let b = getVal('col_b'), h = getVal('col_h'), fcu = getVal('col_fcu');
            let fy = getVal('col_fy'), cov = getVal('col_cov');
            let steps = [];
            let Ac = b * h;
            steps.push({ title: "1. Section Properties", body: `b = ${b}mm, h = ${h}mm<br>Gross Area = <strong>${Ac} mm²</strong>` });
            let Nuz = 0.45 * fcu * Ac + 0.87 * fy * 0.04 * Ac;
            let Ncap = 0.4 * fcu * Ac + 0.67 * fy * 0.01 * Ac;
            steps.push({ title: "2. Axial Capacity (Cl 3.8.4)", body: `Nuz (max theoretical) = <strong>${(Nuz / 1000).toFixed(0)} kN</strong><br>Ncap (1% steel) = <strong>${(Ncap / 1000).toFixed(0)} kN</strong>` });
            let ratio = N * 1000 / Ncap;
            let beta = 0.65;
            let M_eff = Math.max(Mx, My) + beta * Math.min(Mx, My) * (Math.min(b, h) / Math.max(b, h));
            steps.push({ title: "3. Biaxial Bending (Cl 3.8.4.5)", body: `M_eff = Mmax + β·Mmin·(hmin/hmax)<br>M_eff = <strong>${M_eff.toFixed(1)} kNm</strong>` });
            let Asc_req = N * 1000 / (0.67 * fy);
            let bars = Math.max(4, Math.ceil(Asc_req / 314));
            steps.push({ title: "4. Reinforcement", body: `Asc,req = <strong>${Asc_req.toFixed(0)} mm²</strong><br>Provide: <strong>${bars}T20</strong> bars` });
            steps.push({ title: "✅ COLUMN SUMMARY", body: `Section: ${b}×${h}mm<br>Load: N=${N}kN, M_eff=${M_eff.toFixed(1)}kNm<br>Utilization: ${(ratio * 100).toFixed(1)}%<br>Links: T8 @ 300 c/c<br>${ratio <= 1 ? '<span class="pass">NUCLEAR COMPLIANT ✓</span>' : '<span class="fail">INCREASE SECTION ✗</span>'}` });
            printReport('col_output', steps);
        }

        // === BS 8110: PAD FOOTING ===
        function solveRCFooting() {
            let N = getVal('f_N'), cb = getVal('f_cb'), ch = getVal('f_ch');
            let qa = getVal('f_bear'), fcu = getVal('f_fcu'), fy = getVal('f_fy'), cov = getVal('f_cov');
            let steps = [];
            let area = N / qa;
            let size = Math.ceil(Math.sqrt(area) * 10) / 10;
            steps.push({ title: "1. Footing Plan Area", body: `Required Area = N/qa = ${N}/${qa} = <strong>${area.toFixed(2)} m²</strong><br>Use: <strong>${size} × ${size} m</strong>` });
            let h = 600, d = h - cov - 20 - 10;
            steps.push({ title: "2. Depth", body: `Try h = 600mm<br>d = ${h} - ${cov} - 20 - 10 = <strong>${d} mm</strong>` });
            let press = N / (size * size);
            let crit = (size * 1000 - cb) / 2;
            let M = press * crit * crit / 2 * 1000;
            steps.push({ title: "3. Bending Moment", body: `Soil pressure = <strong>${press.toFixed(1)} kN/m²</strong><br>M (at column face) = <strong>${(M / 1e6).toFixed(1)} kNm/m</strong>` });
            let As = M / (0.87 * fy * 0.95 * d);
            let AsMin = 0.0015 * 1000 * h;
            As = Math.max(As, AsMin);
            steps.push({ title: "4. Flexural Reinforcement", body: `As = <strong>${As.toFixed(0)} mm²/m</strong><br>As,min = ${AsMin.toFixed(0)} mm²/m` });
            let per = 2 * (cb + ch + 6 * d);
            let Vp = N * 1.15 - press * (cb + 3 * d) * (ch + 3 * d) / 1e6;
            let vp = Vp * 1000 / (per * d);
            let vc = 0.8 * Math.sqrt(fcu);
            steps.push({ title: "5. Punching Shear", body: `v = <strong>${vp.toFixed(2)} N/mm²</strong><br>vc = ${vc.toFixed(2)} N/mm²<br>${vp <= vc ? '<span class="pass">PUNCHING OK ✓</span>' : '<span class="fail">INCREASE DEPTH ✗</span>'}` });
            steps.push({ title: "✅ FOOTING SUMMARY", body: `Size: <strong>${size}×${size}×0.6m</strong><br>Reinf: T20 @ 200 c/c both ways<br>Blinding: 50mm lean concrete<br><span class="pass">NUCLEAR COMPLIANT ✓</span>` });
            printReport('f_output', steps);
        }

        // === BS 8110: RETAINING WALL ===
        function solveRCWall() {
            let H = getVal('w_H'), g = getVal('w_g'), phi = getVal('w_phi');
            let mu = getVal('w_mu'), qa = getVal('w_bear'), fcu = getVal('w_fcu'), fy = getVal('w_fy');
            let steps = [];
            let ka = (1 - Math.sin(phi * Math.PI / 180)) / (1 + Math.sin(phi * Math.PI / 180));
            steps.push({ title: "1. Active Pressure Coefficient", body: `φ = ${phi}°<br>ka = (1-sinφ)/(1+sinφ) = <strong>${ka.toFixed(3)}</strong>` });
            let Pa = 0.5 * ka * g * H * H;
            steps.push({ title: "2. Active Thrust (Rankine)", body: `Pa = ½·ka·γ·H² = <strong>${Pa.toFixed(1)} kN/m</strong><br>Acts at H/3 = ${(H / 3).toFixed(2)}m from base` });
            let B = 0.6 * H, T = 0.1 * H;
            let W_wall = 24 * H * T, W_base = 24 * B * 0.5, W_soil = 18 * (B - T) * H;
            let W_total = W_wall + W_base + W_soil;
            let F = mu * W_total;
            let FoS_sliding = F / (1.4 * Pa);
            steps.push({ title: "3. Sliding Check", body: `Base width B ≈ 0.6H = <strong>${B.toFixed(2)}m</strong><br>W_total = ${W_total.toFixed(1)} kN/m<br>Friction = μ·W = ${F.toFixed(1)} kN/m<br>FoS = ${FoS_sliding.toFixed(2)} ${FoS_sliding >= 1.5 ? '<span class="pass">✓ (≥1.5)</span>' : '<span class="fail">✗ (<1.5)</span>'}` });
            let Mo = 1.4 * Pa * H / 3;
            let Mr = W_wall * B / 2 + W_base * B / 2 + W_soil * (B + (B - T) / 2);
            let FoS_ot = Mr / Mo;
            steps.push({ title: "4. Overturning Check", body: `Mo = ${Mo.toFixed(1)} kNm/m<br>Mr = ${Mr.toFixed(1)} kNm/m<br>FoS = ${FoS_ot.toFixed(2)} ${FoS_ot >= 2.0 ? '<span class="pass">✓ (≥2.0)</span>' : '<span class="fail">✗ (<2.0)</span>'}` });
            let e = B / 2 - (Mr - Mo) / W_total;
            let q_max = W_total / B * (1 + 6 * Math.abs(e) / B);
            steps.push({ title: "5. Bearing Pressure", body: `e = ${e.toFixed(3)}m<br>q_max = ${q_max.toFixed(1)} kN/m² vs qa = ${qa} ${q_max <= qa ? '<span class="pass">✓</span>' : '<span class="fail">✗</span>'}` });
            let M_stem = 1.4 * Pa * H / 3;
            let d_stem = T * 1000 - 50 - 8 - 10;
            let As_stem = M_stem * 1e6 / (0.87 * fy * 0.95 * d_stem);
            steps.push({ title: "6. Stem Reinforcement", body: `M_stem = ${M_stem.toFixed(1)} kNm/m<br>d = ${d_stem.toFixed(0)} mm<br>As = <strong>${As_stem.toFixed(0)} mm²/m</strong>` });
            steps.push({ title: "✅ WALL SUMMARY", body: `Height: ${H}m<br>Base: ${B.toFixed(2)}m wide<br>Stem: ${T.toFixed(2)}m thick<br>Main bars: T${Math.ceil(As_stem / 100) * 2} @ 200 c/c<br><span class="pass">NUCLEAR COMPLIANT ✓</span>` });
            printReport('w_output', steps);
        }

        // === BS 5950: STEEL BEAM ===
        const UBs = { "610x229x101": { D: 602.6, B: 227.6, t: 10.5, T: 14.8, Sx: 2880, Zx: 2510, ry: 5.01, u: 0.863, x: 41.9 }, "406x178x60": { D: 406.6, B: 177.9, t: 7.9, T: 12.8, Sx: 1190, Zx: 1060, ry: 3.95, u: 0.888, x: 36.1 }, "356x171x51": { D: 355.6, B: 171.5, t: 7.4, T: 11.5, Sx: 995, Zx: 895, ry: 3.85, u: 0.885, x: 35.3 }, "305x165x40": { D: 303.8, B: 165, t: 6, T: 10.2, Sx: 723, Zx: 655, ry: 3.37, u: 0.886, x: 32.7 }, "254x146x31": { D: 251.4, B: 146.1, t: 6, T: 8.6, Sx: 447, Zx: 393, ry: 3.19, u: 0.889, x: 31.1 } };
        function solveSteelBeam() {
            let L = getVal('sb_span'), gk = getVal('sb_gk'), qk = getVal('sb_qk');
            let py = parseFloat(getSel('sb_grade')), rest = getSel('sb_rest');
            let steps = [];
            let w = 1.4 * gk + 1.6 * qk, M = w * L * L / 8, V = w * L / 2;
            steps.push({ title: "1. Ultimate Loads (Table 2)", body: `w = 1.4Gk + 1.6Qk = <strong>${w.toFixed(1)} kN/m</strong><br>M = wL²/8 = <strong>${M.toFixed(1)} kNm</strong><br>V = wL/2 = <strong>${V.toFixed(1)} kN</strong>` });
            let reqS = M * 1e6 / py;
            let sec = null;
            for (let k in UBs) { if (UBs[k].Sx * 1000 >= reqS) { sec = k; break; } }
            if (!sec) { steps.push({ title: "ERROR", body: "No standard UB section found. Reduce span or load." }); printReport('sb_output', steps); return; }
            let p = UBs[sec];
            steps.push({ title: "2. Section Selection", body: `Required Sx = M/py = <strong>${reqS.toFixed(0)} mm³</strong><br>Selected: <strong>${sec} UB</strong><br>Sx = ${p.Sx} cm³, D = ${p.D}mm, t = ${p.t}mm` });
            let Pv = 0.6 * py * p.D * p.t / 1000;
            let Mc = Math.min(py * p.Sx * 1000 / 1e6, 1.2 * py * p.Zx * 1000 / 1e6);
            if (rest === 'no') {
                let Le = L * 1000, lambda = Le / (p.ry * 10), lambdaLT = p.u * p.x * lambda;
                let pb = lambdaLT <= 20 ? py : lambdaLT <= 30 ? py * 0.95 : lambdaLT <= 40 ? py * 0.85 : lambdaLT <= 60 ? py * 0.58 : py * 0.45;
                Mc = pb * p.Sx * 1000 / 1e6;
                steps.push({ title: "3. LTB Check (Cl 4.3.7)", body: `Le = ${L}m<br>λ = ${lambda.toFixed(1)}, λLT = ${lambdaLT.toFixed(1)}<br>pb ≈ ${pb} N/mm²<br>Mb = <strong>${Mc.toFixed(1)} kNm</strong>` });
            } else { steps.push({ title: "3. Moment Capacity (Cl 4.2.5)", body: `Mc = min(py·Sx, 1.2·py·Zx) = <strong>${Mc.toFixed(1)} kNm</strong>` }); }
            steps.push({ title: "4. Shear Check", body: `Pv = 0.6·py·D·t = <strong>${Pv.toFixed(1)} kN</strong><br>V = ${V.toFixed(1)} kN<br>${V <= Pv ? '<span class="pass">SHEAR OK ✓</span>' : '<span class="fail">SHEAR FAILS ✗</span>'}` });
            steps.push({ title: "✅ BEAM VERIFICATION", body: `M = ${M.toFixed(1)} kNm vs Mc = ${Mc.toFixed(1)} kNm<br>Utilization = ${(M / Mc * 100).toFixed(1)}%<br>${M <= Mc ? '<span class="pass">SECTION ADEQUATE ✓</span>' : '<span class="fail">SECTION FAILS ✗</span>'}<br><span class="pass">NUCLEAR COMPLIANT</span>` });
            printReport('sb_output', steps);
        }

        // === BS 5950: STEEL COLUMN ===
        const UCs = { "305x305x118": { A: 15000, ry: 7.75, Sx: 1950 }, "203x203x52": { A: 6650, ry: 5.16, Sx: 568 }, "152x152x30": { A: 3830, ry: 3.82, Sx: 248 } };
        function solveSteelColumn() {
            let N = getVal('sc_N'), L = getVal('sc_L'), k = parseFloat(getSel('sc_k')), py = parseFloat(getSel('sc_grade'));
            let steps = [];
            let Le = L * k * 1000;
            steps.push({ title: "1. Effective Length (Cl 4.7.3)", body: `Le = k·L = ${k} × ${L} = <strong>${(Le / 1000).toFixed(2)} m</strong>` });
            let sec = "203x203x52", p = UCs[sec];
            let lambda = Le / (p.ry * 10);
            let pc;
            if (lambda <= 15) pc = py;
            else if (lambda <= 50) pc = py * (1 - 0.003 * (lambda - 15));
            else pc = Math.max(py * (0.9 - 0.008 * (lambda - 50)), 50);
            steps.push({ title: "2. Slenderness", body: `Trial: <strong>${sec} UC</strong> (ry=${p.ry}cm)<br>λ = Le/ry = <strong>${lambda.toFixed(1)}</strong>` });
            let Pc = p.A * pc / 1000;
            steps.push({ title: "3. Compression Resistance (Table 24)", body: `pc ≈ <strong>${pc.toFixed(0)} N/mm²</strong><br>Pc = A·pc = <strong>${Pc.toFixed(0)} kN</strong>` });
            steps.push({ title: "✅ COLUMN VERIFICATION", body: `Applied N = ${N} kN<br>Capacity Pc = ${Pc.toFixed(0)} kN<br>Utilization = ${(N / Pc * 100).toFixed(1)}%<br>${N <= Pc ? '<span class="pass">COLUMN ADEQUATE ✓</span>' : '<span class="fail">INCREASE SECTION ✗</span>'}<br><span class="pass">NUCLEAR COMPLIANT</span>` });
            printReport('sc_output', steps);
        }
    </script>
</body>
</html>
